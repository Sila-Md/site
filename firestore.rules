rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Subdomains: Public read, write restricted
    match /subdomains/{subdomainId} {
      allow read: if true;
      allow write: if true; // In a real app we'd restrict this with proper auth, for now we assume admin UI handles PIN
    }

    // Config: Public read (for pin check?), write restricted
    match /configs/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Stats: Public increment, public read
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
